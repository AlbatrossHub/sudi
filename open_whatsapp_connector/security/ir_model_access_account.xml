<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Self-service WhatsApp account toggle (Odoo 20 port: ir.model.access
        became ir.access). Grants internal users create/read/update (never
        unlink) on owa.account. Shipped INACTIVE; set_values() flips it
        active only in 'own_team' (self-service) mode. Row visibility is
        capped by the always-active conditional restriction
        `owa_account_own_team_rule` (security/ir_rules.xml), as in v19.
        noupdate: keep the runtime active flag across -u. (#F085)
    -->
    <data noupdate="1">
    <record id="access_owa_account_user_manage" model="ir.access">
        <field name="name">owa.account.user.manage</field>
        <field name="model_id" ref="model_owa_account"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">cru</field>
        <field name="active" eval="False"/>
    </record>
    </data>
</odoo>
