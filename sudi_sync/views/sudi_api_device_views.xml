<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sudi_api_device_list" model="ir.ui.view">
        <field name="name">sudi.api.device.list</field>
        <field name="model">sudi.api.device</field>
        <field name="arch" type="xml">
            <list string="Mobile Devices" create="0">
                <field name="user_id"/>
                <field name="audience"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="last_seen_at"/>
                <field name="sync_cursor"/>
                <field name="token_epoch"/>
                <field name="revoked" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_sudi_api_device_form" model="ir.ui.view">
        <field name="name">sudi.api.device.form</field>
        <field name="model">sudi.api.device</field>
        <field name="arch" type="xml">
            <form string="Mobile Device" create="0">
                <header>
                    <button name="action_revoke"
                            string="Revoke this device"
                            type="object"
                            class="btn-danger"
                            confirm="This signs the handset out immediately and it cannot sync again until it is re-registered. The user's other devices keep working. Continue?"
                            invisible="revoked"/>
                    <button name="action_unrevoke"
                            string="Allow again"
                            type="object"
                            invisible="not revoked"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="not revoked"/>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="device_uid"/>
                            <field name="audience"/>
                            <field name="platform"/>
                            <field name="app_version"/>
                        </group>
                        <group>
                            <field name="last_seen_at"/>
                            <field name="sync_cursor"/>
                            <field name="token_epoch"/>
                            <field name="push_token"/>
                            <field name="revoked"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sudi_api_device" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">sudi.api.device</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
