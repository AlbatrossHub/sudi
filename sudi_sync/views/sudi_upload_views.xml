<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sudi_upload_list" model="ir.ui.view">
        <field name="name">sudi.upload.list</field>
        <field name="model">sudi.upload</field>
        <field name="arch" type="xml">
            <list string="Staged Uploads" create="0" edit="0">
                <field name="reference"/>
                <field name="user_id"/>
                <field name="mimetype"/>
                <field name="file_size" string="Bytes"/>
                <field name="consumed_model" string="Claimed by"/>
                <field name="consumed_res_id" string="Record"/>
                <field name="consumed_at"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <record id="action_sudi_upload" model="ir.actions.act_window">
        <field name="name">Staged Uploads</field>
        <field name="res_model">sudi.upload</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
