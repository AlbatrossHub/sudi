<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference Ledger: off-book settlements. Menu only in developer mode,
         records only for the Reference Ledger group (menu hiding is not access control). -->
    <record id="view_sudi_reference_statement_list" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.statement.list</field>
        <field name="model">sudi.diamond.reference.statement</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'reopened'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="delivery_ids" widget="many2many_tags"/>
                <field name="pcs_total" sum="Pcs"/>
                <field name="carats_total" sum="Carats"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'settled'" decoration-danger="state == 'reopened'"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sudi_reference_statement_form" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.statement.form</field>
        <field name="model">sudi.diamond.reference.statement</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_reopen" string="Reopen" type="object" class="btn-secondary"
                            invisible="state != 'settled'"
                            confirm="Reopen this reference statement? Its deliveries go back to 'To bill' and the change is logged."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="pcs_total"/>
                            <field name="carats_total"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="receipt_id"/>
                                    <field name="delivery_id"/>
                                    <field name="job_type_id"/>
                                    <field name="size"/>
                                    <field name="pcs" sum="Pcs"/>
                                    <field name="carats" sum="Carats"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Charge"/>
                                    <field name="returned_without_work"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deliveries" name="deliveries">
                            <field name="delivery_ids"/>
                            <field name="receipt_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal note"/>
                            <field name="reopen_reason" invisible="not reopen_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sudi_reference_statement_search" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.statement.search</field>
        <field name="model">sudi.diamond.reference.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_ids"/>
                <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <filter name="reopened" string="Reopened" domain="[('state', '=', 'reopened')]"/>
                <separator/>
                <filter name="fy" string="This Financial Year (Apr–Mar)"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-04-01')), ('date', '&lt;', (context_today() + relativedelta(months=9)).strftime('%Y-04-01'))]"/>
                <filter name="fy_last" string="Last Financial Year"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=15)).strftime('%Y-04-01')), ('date', '&lt;', (context_today() - relativedelta(months=3)).strftime('%Y-04-01'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sudi_reference_line_list" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.line.list</field>
        <field name="model">sudi.diamond.reference.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state == 'reopened'">
                <field name="statement_id"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="receipt_id"/>
                <field name="delivery_id"/>
                <field name="job_type_id"/>
                <field name="pcs" sum="Pcs"/>
                <field name="carats" sum="Carats"/>
                <field name="price_unit"/>
                <field name="amount" sum="Charge"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sudi_reference_line_pivot" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.line.pivot</field>
        <field name="model">sudi.diamond.reference.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="job_type_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="pcs" type="measure"/>
                <field name="carats" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sudi_reference_line_graph" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.line.graph</field>
        <field name="model">sudi.diamond.reference.line</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="partner_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sudi_reference_line_search" model="ir.ui.view">
        <field name="name">sudi.diamond.reference.line.search</field>
        <field name="model">sudi.diamond.reference.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="statement_id"/>
                <field name="partner_id"/>
                <field name="job_type_id"/>
                <field name="receipt_id"/>
                <field name="delivery_id"/>
                <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <separator/>
                <filter name="fy" string="This Financial Year (Apr–Mar)"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-04-01')), ('date', '&lt;', (context_today() + relativedelta(months=9)).strftime('%Y-04-01'))]"/>
                <filter name="fy_last" string="Last Financial Year"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=15)).strftime('%Y-04-01')), ('date', '&lt;', (context_today() - relativedelta(months=3)).strftime('%Y-04-01'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_job_type" string="Job Type" context="{'group_by': 'job_type_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_receipt" string="Receipt" context="{'group_by': 'receipt_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sudi_reference_statement" model="ir.actions.act_window">
        <field name="name">Reference Statements</field>
        <field name="res_model">sudi.diamond.reference.statement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sudi_reference_statement_search"/>
        <field name="context">{'search_default_settled': 1, 'search_default_fy': 1}</field>
    </record>

    <record id="action_sudi_reference_line" model="ir.actions.act_window">
        <field name="name">Reference Ledger</field>
        <field name="res_model">sudi.diamond.reference.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_sudi_reference_line_search"/>
        <field name="context">{'search_default_settled': 1, 'search_default_fy': 1, 'search_default_group_partner': 1}</field>
    </record>

    <menuitem id="menu_sudi_reference_ledger_root"
              name="Diamond Reference Ledger"
              parent="base.menu_custom"
              sequence="90"
              groups="base.group_no_one,diamond.group_sudi_reference_ledger"/>
    <menuitem id="menu_sudi_reference_ledger"
              name="Ledger (by line)"
              parent="menu_sudi_reference_ledger_root"
              action="action_sudi_reference_line"
              sequence="10"
              groups="base.group_no_one,diamond.group_sudi_reference_ledger"/>
    <menuitem id="menu_sudi_reference_statements"
              name="Statements"
              parent="menu_sudi_reference_ledger_root"
              action="action_sudi_reference_statement"
              sequence="20"
              groups="base.group_no_one,diamond.group_sudi_reference_ledger"/>
</odoo>
