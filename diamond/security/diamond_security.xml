<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_sudi_diamond_operations">
            <field name="name">Onfield</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
        </record>

        <record id="group_sudi_pickup_app" model="res.groups">
            <field name="name">Pickup App</field>
            <field name="sequence">5</field>
            <field name="comment">Grants access to the Pickup navigation app. Auto-assigned when "Notify on Jangad Upload" is enabled.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="group_sudi_pickup_delivery_operator" model="res.groups">
            <field name="name">Onfield User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sudi_diamond_operations"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('group_sudi_pickup_app'))]"/>
        </record>

        <!-- Job work is done by different people from pickup and delivery, so
             it is a role of its own rather than a second menu on the Onfield
             group. Deliberately implies neither: an operator who also does job
             work holds both groups. The 19.0.1.4.0 migration grants this to
             everyone who currently has Onfield User, so nobody loses the menu
             they had yesterday. -->
        <record id="group_sudi_job_work_user" model="res.groups">
            <field name="name">Job Work User</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="res_groups_privilege_sudi_diamond_operations"/>
            <!-- Timesheets/User is part of the role, not an extra an
                 administrator has to remember: booking time against a receipt
                 is what a job-work person does all day, and the implied group
                 is the narrow "own timesheets only" one. Without it the timer
                 fails on account.analytic.line create. -->
            <field name="implied_ids" eval="[                 Command.link(ref('base.group_user')),                 Command.link(ref('hr_timesheet.group_hr_timesheet_user')),             ]"/>
        </record>

        <!-- The office person who validates a collected jangad from the staff
             app: views the pages, fills the item table, marks it READY. That
             is exactly what a stock user does on the receipt form, so the role
             implies it rather than inventing a parallel set of rights. -->
        <record id="group_sudi_office_validator" model="res.groups">
            <field name="name">Office: Validate Jangads (app)</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sudi_diamond_operations"/>
            <field name="comment">Opens the Office tab of the staff app: collected jangads awaiting validation, their item table, and Mark READY for job work.</field>
            <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record model="res.groups.privilege" id="res_groups_privilege_sudi_diamond_billing">
            <field name="name">Job Work Billing</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
        </record>

        <!-- Reviews delivered job work and settles it. Implies Invoicing so the
             draft invoices can be created under the reviewer's own rights. -->
        <record id="group_sudi_billing_reviewer" model="res.groups">
            <field name="name">Billing Reviewer</field>
            <field name="privilege_id" ref="res_groups_privilege_sudi_diamond_billing"/>
            <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user')), Command.link(ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Sees and reopens reference statements. Kept separate from the
             reviewer on purpose: settling as reference needs no ledger access. -->
        <record id="group_sudi_reference_ledger" model="res.groups">
            <field name="name">Reference Ledger</field>
            <field name="privilege_id" ref="res_groups_privilege_sudi_diamond_billing"/>
            <field name="implied_ids" eval="[Command.link(ref('group_sudi_billing_reviewer'))]"/>
        </record>

        <record id="stock.group_stock_manager" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_sudi_billing_reviewer'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_sudi_reference_ledger'))]"/>
        </record>

        </data>
</odoo>
