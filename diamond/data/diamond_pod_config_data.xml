<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Proof of delivery. The field app captures the receiver's name, a drawn
         signature and photos on every delivery; which of the three is *mandatory*
         is configuration, so the business can tighten it without an app release.

         All three ship OFF. Requiring any of them changes what an existing
         "Mark Delivered" click does, for office staff and the current web flow
         as well as the app, so the switch belongs to the operations team on the
         day they are ready for it rather than to this file on upgrade day. The
         enforcement is written and tested; only the default is permissive. -->
    <data noupdate="1">
        <record id="param_sudi_pod_require_receiver_name" model="ir.config_parameter">
            <field name="key">sudi_diamond.pod_require_receiver_name</field>
            <field name="value">0</field>
        </record>
        <record id="param_sudi_pod_require_signature" model="ir.config_parameter">
            <field name="key">sudi_diamond.pod_require_signature</field>
            <field name="value">0</field>
        </record>
        <record id="param_sudi_pod_require_photo" model="ir.config_parameter">
            <field name="key">sudi_diamond.pod_require_photo</field>
            <field name="value">0</field>
        </record>
    </data>
</odoo>
