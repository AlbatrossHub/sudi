<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_sudi_api_jwt_issuer" model="ir.config_parameter">
            <field name="key">sudi_api.jwt_issuer</field>
            <field name="value">sudi</field>
        </record>

        <!-- A day, not an hour. An operator out of coverage all morning has to
             be able to flush their queue at 14:00 without a round trip they
             cannot make. Revocation is by device, not by expiry. -->
        <record id="param_sudi_api_access_ttl" model="ir.config_parameter">
            <field name="key">sudi_api.access_token_ttl_minutes</field>
            <field name="value">1440</field>
        </record>

        <record id="param_sudi_api_refresh_ttl" model="ir.config_parameter">
            <field name="key">sudi_api.refresh_token_ttl_days</field>
            <field name="value">90</field>
        </record>

        <!-- Shipped ON. Without it every internal account could authenticate
             against the field endpoints, which is the same class of mistake as
             the record rules that used to be granted to base.group_user. -->
        <record id="param_sudi_api_field_groups_only" model="ir.config_parameter">
            <field name="key">sudi_api.field_groups_only</field>
            <field name="value">1</field>
        </record>
    </data>
</odoo>
