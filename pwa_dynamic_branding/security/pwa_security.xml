<?xml version="1.0" encoding="UTF-8"?>
<odoo>
      <!-- ========================================
         Security Groups
         Note: In Odoo 19, res.groups uses 'app_ids' instead of 'category_id'
    ======================================== -->
      <record id="group_pwa_user" model="res.groups">
            <field name="name">PWA User</field>
            <field name="comment">Can view PWA configuration</field>
      </record>

      <record id="group_pwa_manager" model="res.groups">
            <field name="name">PWA Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_pwa_user'))]" />
            <field name="comment">Can manage PWA configuration and branding</field>
      </record>

      <!-- Add PWA Manager to Administration / Settings group -->
      <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_pwa_manager'))]" />
      </record>

      <!-- ========================================
         Record Rules
    ======================================== -->

      <!-- PWA Config - Company Rule -->
      <record id="pwa_config_company_rule" model="ir.rule">
            <field name="name">PWA Config: Multi-Company</field>
            <field name="model_id" ref="model_pwa_config" />
            <field name="domain_force">[
                  '|',
                  ('company_id', '=', False),
                  ('company_id', 'in', company_ids)
                  ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
      </record>

      <!-- PWA AI Branding - Company Rule -->
      <record id="pwa_ai_branding_company_rule" model="ir.rule">
            <field name="name">PWA AI Branding: Multi-Company</field>
            <field name="model_id" ref="model_pwa_ai_branding" />
            <field name="domain_force">[
                  '|',
                  ('company_id', '=', False),
                  ('company_id', 'in', company_ids)
                  ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
      </record>

</odoo>